# PostgreSQL connection string
# Local dev example: postgresql://postgres:postgres@localhost:5432/smart_queue
# Production (Supabase): use the "connection pooling" URI from your project settings
DATABASE_URL=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Supabase Realtime (required for live staff/customer updates)
# Dashboard → Project Settings → API Keys
# Browser (public): Project URL + anon key, or publishable key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional alias for newer Supabase keys:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server broadcast (preferred): service_role or secret key. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Optional public origin for QR codes (no trailing slash). If unset, the request Host is used.
# NEXT_PUBLIC_APP_URL=https://your-domain.com
